{
  "name": "ade",
  "private": true,
  "version": "0.1.0",
  "description": "ADE — Agent Development Environment: one workspace, every device, every agent.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @ade/shared",
    "build": "npm run build -w @ade/shared && npm run build -w @ade/server && npm run build -w @ade/web",
    "dev": "npm run build:shared && concurrently -n server,web -c blue,green \"npm:dev -w @ade/server\" \"npm:dev -w @ade/web\"",
    "start": "node packages/server/dist/index.js",
    "smoke": "node packages/server/scripts/smoke.mjs",
    "smoke:terminal": "node packages/server/scripts/terminal-smoke.mjs",
    "smoke:files": "node packages/server/scripts/files-smoke.mjs",
    "smoke:management": "node packages/server/scripts/file-management-smoke.mjs",
    "smoke:web-files": "node --import tsx packages/web/scripts/file-moves-smoke.mjs",
    "smoke:quick-open": "node --import tsx packages/web/scripts/quick-open-smoke.mjs",
    "smoke:drafts": "node --import tsx packages/web/scripts/drafts-smoke.mjs",
    "smoke:task-notices": "node --import tsx packages/web/scripts/task-notices-smoke.mjs",
    "smoke:browser-task-notices": "node packages/web/scripts/task-notices-browser-smoke.mjs",
    "smoke:presence": "npm run build -w @ade/server && node packages/server/scripts/presence-smoke.mjs",
    "smoke:push": "npm run build -w @ade/server && node packages/server/scripts/push-smoke.mjs",
    "smoke:lock": "npm run build -w @ade/server && node packages/server/scripts/lock-smoke.mjs",
    "smoke:browser-drafts": "node packages/web/scripts/drafts-browser-smoke.mjs",
    "smoke:handoff": "node packages/server/scripts/handoff-smoke.mjs",
    "smoke:chain": "node packages/server/scripts/chain-smoke.mjs",
    "smoke:chain-recovery": "node packages/server/scripts/chain-recovery-smoke.mjs",
    "smoke:pi": "npm run build -w @ade/shared && npm run build -w @ade/server && node packages/server/scripts/pi-smoke.mjs",
    "smoke:agents": "npm run build -w @ade/shared && npm run build -w @ade/server && node packages/server/scripts/agents-smoke.mjs",
    "smoke:task-log": "npm run build -w @ade/shared && npm run build -w @ade/server && node packages/server/scripts/task-log-smoke.mjs",
    "smoke:browser-agents": "node packages/web/scripts/agent-availability-browser-smoke.mjs",
    "smoke:browser-editor-loading": "node packages/web/scripts/editor-loading-browser-smoke.mjs",
    "smoke:browser-ui": "node packages/web/scripts/ui-layout-browser-smoke.mjs",
    "smoke:browser-chain-recovery": "node packages/web/scripts/chain-recovery-browser-smoke.mjs",
    "smoke:security": "node packages/server/scripts/security-smoke.mjs",
    "smoke:git": "node packages/server/scripts/git-smoke.mjs",
    "smoke:browser-git": "node packages/web/scripts/git-browser-smoke.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
