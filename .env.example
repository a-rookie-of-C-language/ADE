# Copy to .env (or set in your shell) — env vars override ade.config.json
# ADE_WORKSPACE=./workspace
# ADE_PORT=8787
# ADE_HOST=127.0.0.1
# Generate one with: node -e "console.log(crypto.randomUUID())"
# ADE_TOKEN=
# Comma-separated exact HTTPS origins if an external reverse proxy rewrites Host
# ADE_ALLOWED_ORIGINS=https://ade.example.com
# Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
# ADE_VAPID_PUBLIC_KEY=
# ADE_VAPID_PRIVATE_KEY=
# ADE_VAPID_SUBJECT=mailto:you@example.com
